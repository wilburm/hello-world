# Database
DATABASE_URL="postgresql://user:password@localhost:5432/exchange_rates?schema=public"
# Or for SQLite (for testing):
# DATABASE_URL="file:./dev.db"

# Collector Configuration
COLLECTOR_INTERVAL="*/5 * * * *"  # Every 5 minutes (cron format)
EXCHANGE_API_URL="https://api.exchangerate-api.com/v4/latest/CNY"
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info
